{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/anil-ganti-nbc/standards-clank/schemas/exception.schema.json",
  "title": "Exception",
  "description": "A recorded, auditable deviation from a ratified standard for a specific Clank.",
  "type": "object",
  "properties": {
    "standard_id": {
      "type": "string",
      "description": "id of the standard this exception deviates from.",
      "pattern": "^STD-[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$"
    },
    "clank": {
      "type": "string",
      "description": "Name of the Clank this exception applies to."
    },
    "scope": {
      "type": "string",
      "description": "What part of the standard the exception covers (all, or a specific acceptance criterion)."
    },
    "reason": {
      "type": "string"
    },
    "proposed_by": {
      "type": "string",
      "description": "Human or agent identifier."
    },
    "status": {
      "type": "string",
      "enum": ["PROPOSED", "APPROVED", "REJECTED", "EXPIRED", "SUPERSEDED"]
    },
    "approved_by": {
      "type": ["string", "null"],
      "description": "Must be a human operator identifier. Null while status is PROPOSED."
    },
    "introduced": {
      "type": "string",
      "format": "date"
    },
    "review_after": {
      "type": ["string", "null"],
      "format": "date"
    },
    "expires": {
      "type": ["string", "null"],
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["standard_id", "clank", "reason", "proposed_by", "status", "introduced"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "APPROVED" } } },
      "then": { "required": ["standard_id", "clank", "reason", "proposed_by", "status", "introduced", "approved_by"] }
    }
  ]
}
